# ==========================================
# Frontend Admin Panel Environment Variables
# ==========================================

# Standalone / Offline Mode
# "true"  = Runs fully offline without any database connection (mock data for client review)
# "false" = Connects to the live backend REST API
NEXT_PUBLIC_STANDALONE=true

# Backend REST API URL (Used when NEXT_PUBLIC_STANDALONE=false)
# Set this to your live backend domain or subdomain on cPanel (e.g., https://api.yourdomain.com/)
NEXT_PUBLIC_BASE_URL=http://localhost:5050/

# API Secret Key Gatekeeper (Must match backend secretKey)
NEXT_PUBLIC_SECRET_KEY=5TIvw5cpc0

# Project Name (Optional display name)
NEXT_PUBLIC_PROJECT_NAME=
